{
    "name": "pterodactyl-addons/mod-manager",
    "description": "CurseForge integrated mod manager for Raptor Panel",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "pterodactyl",
        "raptor-panel",
        "curseforge",
        "mods",
        "minecraft"
    ],
    "authors": [
        {
            "name": "Raptor Panel Team",
            "email": "support@raptorpanel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PterodactylAddons\\ModManager\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^10.0",
        "guzzlehttp/guzzle": "^7.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "pterodactyl": {
            "minimum_version": "1.11.0",
            "maximum_version": "1.99.99",
            "raptor_panel": {
                "minimum_version": "1.3.13",
                "maximum_version": "1.99.99"
            }
        }
    }
}
